# ============================================================
# FCC Website — Environment Variables Reference
# ============================================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to Git.

# ------------------------------------------------------------
# Auth.js (next-auth)
# ------------------------------------------------------------

# A random 32-byte secret used to sign/encrypt session JWTs.
# Generate one with: npx auth secret
AUTH_SECRET=your-generated-secret-here

# Microsoft Entra ID (Azure AD) — Application (client) ID
AUTH_MICROSOFT_ENTRA_ID_ID=your-entra-app-client-id

# Microsoft Entra ID — Client Secret Value (not the secret ID)
AUTH_MICROSOFT_ENTRA_ID_SECRET=your-entra-client-secret-value

# Microsoft Entra ID — Tenant-specific issuer URL
# Format: https://login.microsoftonline.com/<tenant-id>/v2.0
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/YOUR_TENANT_ID/v2.0

# ------------------------------------------------------------
# CMS GitHub Bot Token
# ------------------------------------------------------------

# Fine-grained GitHub Personal Access Token for the FCC CMS bot account.
# Required scopes: Contents (read & write), Metadata (read), Pull requests (read).
# Scoped to the kartikeyiamai/fcc repository only.
# NEVER expose this as a NEXT_PUBLIC_* variable.
CMS_GITHUB_TOKEN=github_pat_your_token_here

# ------------------------------------------------------------
# Auth.js internal (set automatically by next-auth in some flows)
# ------------------------------------------------------------

# The canonical URL of your deployment. Required in production.
# Example: https://main.d2fqkki8q9kcbn.amplifyapp.com
NEXTAUTH_URL=https://main.d2fqkki8q9kcbn.amplifyapp.com
AUTH_URL=https://main.d2fqkki8q9kcbn.amplifyapp.com

